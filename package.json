{
  "name": "chess-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:claims": "tsx scripts/check-claims.ts",
    "check:claims:test": "tsx scripts/check-claims.check.ts",
    "check:rules": "tsx src/lib/lichessRules.check.ts",
    "check:rules:parity": "python3 -I scripts/check-rule-parity.py",
    "check:gate": "tsx src/lib/studyGate.check.ts",
    "check:gate:parity": "python3 -I scripts/check-gate-parity.py",
    "check:review": "tsx src/features/review/labels.check.ts",
    "check:home": "tsx src/features/home/progress.check.ts && tsx src/features/home/sanitize.check.ts",
    "check:measure": ".venv/bin/python -I scripts/measure/selftest.py",
    "check:safety": "tsx src/features/safety/accept.check.ts && tsx src/features/safety/schedule.check.ts && tsx src/features/safety/queue.check.ts",
    "e2e:safety": "tsx src/features/safety/safety.e2e.ts",
    "e2e:review": "tsx src/features/review/review.e2e.ts",
    "e2e:home": "tsx src/features/home/home.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "stockfish": "^19.0.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
